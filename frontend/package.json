{
  "name": "@whitelabel/frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../docs/api/openapi.yaml -o packages/api-client/src/schema.ts",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && npm run typecheck -w @whitelabel/storefront",
    "test": "vitest run",
    "build": "npm run build -w @whitelabel/admin && npm run build -w @whitelabel/console && npm run build -w @whitelabel/storefront",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
