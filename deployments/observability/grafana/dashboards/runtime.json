{
  "uid": "ecommerce-runtime",
  "title": "Banco e processos",
  "description": "Pool de conexões, consultas e runtime Go por serviço.",
  "tags": [
    "ecommerce"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
